temp/
out/
build/
dist/
*.log
*.tmp

# ---- Frida server binary (large) ----
frida-server*
!frida-server.md

# ---- Screenshots / captures ----
*.png
*.jpg
*.jpeg
*.gif
*.pcap

# ---- OS / editor ----
.DS_Store
Thumbs.db
